{
  "name": "openonyx",
  "version": "1.0.4",
  "description": "A local-first knowledge management tool with graph-based note linking",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/dev/start-electron.cjs\"",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "tsc && vite build && tsc -p tsconfig.electron.json && electron-builder --publish never",
    "package:linux": "tsc && vite build && tsc -p tsconfig.electron.json && electron-builder --linux dir AppImage --x64 --publish never && node scripts/linux/package-linux.js",
    "package:pacman": "tsc && vite build && tsc -p tsconfig.electron.json && electron-builder --linux dir --x64 --publish never && node scripts/linux/package-linux.js",
    "package:win": "tsc && vite build && tsc -p tsconfig.electron.json && electron-builder --win nsis portable --x64 --publish never",
    "package:mac": "tsc && vite build && tsc -p tsconfig.electron.json && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "package:all": "tsc && vite build && tsc -p tsconfig.electron.json && electron-builder --linux AppImage deb rpm pacman --win nsis portable --mac dmg zip --publish never",
    "lint": "tsc --noEmit",
    "test:canvas-compat": "node scripts/test-canvas-compat.cjs",
    "test:obsidian-api": "node scripts/test-obsidian-api-compat.cjs",
    "test:plugin-runtime": "vitest run tests/plugin-runtime.test.ts",
    "test:excalidraw-live": "node scripts/test-excalidraw-live.cjs",
    "test:kanban-live": "node scripts/test-kanban-live.cjs",
    "test:notebook-navigator-live": "node scripts/test-notebook-navigator-live.cjs",
    "fetch:plugin-fixtures": "node scripts/fetch-plugin-fixtures.cjs",
    "install:pandoc-backend": "node scripts/install-pandoc-backend.cjs",
    "test:pandoc-backend": "node scripts/test-pandoc-backend.cjs",
    "test:plugin-bundles": "node scripts/fetch-plugin-fixtures.cjs && vitest run tests/real-plugin-bundles.test.ts",
    "test:plugin-compat": "node scripts/test-obsidian-api-compat.cjs && vitest run tests/plugin-runtime.test.ts && node scripts/test-pandoc-backend.cjs && node scripts/fetch-plugin-fixtures.cjs && vitest run tests/real-plugin-bundles.test.ts"
  },
  "keywords": [
    "notes",
    "knowledge-management",
    "markdown",
    "graph"
  ],
  "author": {
    "name": "OpenOnyx",
    "email": "openonyx@gmail.com"
  },
  "homepage": "https://github.com/OpenOnyx/OpenOnyx",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenOnyx/OpenOnyx.git"
  },
  "bugs": {
    "url": "https://github.com/OpenOnyx/OpenOnyx/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.8",
    "@replit/codemirror-vim": "^6.3.0",
    "@supabase/supabase-js": "^2.104.1",
    "@xenova/transformers": "^2.17.2",
    "codemirror": "^5.65.20",
    "d3": "^7.9.0",
    "dompurify": "^3.2.7",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.1.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.44",
    "kill-port": "^2.0.1",
    "lucide": "^1.14.0",
    "lucide-react": "^1.8.0",
    "marked": "^15.0.8",
    "marked-katex-extension": "^5.1.7",
    "moment": "^2.30.1",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "@protobufjs/utf8": "1.1.1",
    "@codemirror/state": "$@codemirror/state",
    "sharp": "^0.35.0",
    "electron-builder": "^26.15.3",
    "app-builder-lib": "^26.15.3",
    "dmg-builder": "^26.15.3",
    "builder-util-runtime": "^9.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "obsidian": "^1.13.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.2",
    "vite": "^6.3.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.openonyx.app",
    "productName": "OpenOnyx",
    "copyright": "Copyright © 2026 OpenOnyx",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "executableName": "openonyx",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "deb": {
      "priority": "optional",
      "afterInstall": "scripts/linux/after-install.sh",
      "fpm": [
        "--no-auto-depends"
      ],
      "depends": [
        "gtk3",
        "libnss3",
        "libasound2",
        "libxss1",
        "libxtst6",
        "libsecret-1-0",
        "xdg-utils"
      ]
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none",
        "--no-auto-depends"
      ]
    },
    "pacman": {
      "fpm": [
        "--no-auto-depends"
      ],
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "xdg-utils",
        "at-spi2-core",
        "cairo",
        "dbus",
        "expat",
        "glib2",
        "glibc",
        "hicolor-icon-theme",
        "libcups",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "mesa",
        "nspr",
        "pango",
        "systemd-libs",
        "util-linux-libs"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "backgroundColor": "#121212"
    }
  }
}
