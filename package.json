{
  "name": "openobsidian",
  "version": "1.0.0",
  "description": "A local-first knowledge management tool with graph-based note linking",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/dev/start-electron.cjs\"",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "lint": "tsc --noEmit",
    "test:canvas-compat": "node scripts/test-canvas-compat.cjs"
  },
  "keywords": [
    "notes",
    "knowledge-management",
    "markdown",
    "graph"
  ],
  "author": "OpenObsidian",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-vim": "^6.3.0",
    "@supabase/supabase-js": "^2.104.1",
    "@xenova/transformers": "^2.17.2",
    "d3": "^7.9.0",
    "dompurify": "^3.2.6",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.1.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.44",
    "kill-port": "^2.0.1",
    "lucide": "^1.14.0",
    "lucide-react": "^1.8.0",
    "marked": "^15.0.8",
    "marked-katex-extension": "^5.1.7",
    "moment": "^2.30.1",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "protobufjs": "7.5.8",
    "@protobufjs/utf8": "1.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.3.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.openobsidian.app",
    "productName": "OpenObsidian",
    "copyright": "Copyright © 2026 OpenObsidian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "public/icons"
    },
    "deb": {
      "priority": "optional",
      "afterInstall": "scripts/linux/after-install.sh"
    }
  }
}
